<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:id="@+id/otp_back"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="‹  Back"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="Verify your number"
        android:textColor="@color/text_primary"
        android:textSize="27sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/otp_destination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="25dp"
        android:text="Enter the 6-digit code sent to your phone."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
    <EditText
        android:id="@+id/otp_code"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:hint="• • • • • •"
        android:inputType="number"
        android:letterSpacing="0.35"
        android:maxLength="6"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="22sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Demo verification code: 123456"
        android:textColor="@color/green"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/otp_verify"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_primary_button"
        android:gravity="center"
        android:text="Verify"
        android:textColor="@color/background"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>